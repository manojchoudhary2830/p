{
  "name": "@pgbooking/backend",
  "version": "1.0.0",
  "description": "NextGen PG & Room Booking Platform \u2014 Backend API",
  "private": true,
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --require tsconfig-paths/register src/server.ts",
    "build": "tsc --project tsconfig.json; node -e \"process.exit(require('fs').existsSync('dist/server.js') ? 0 : 1)\"",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{ts,tsx}' --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,json}'",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest --testPathPattern='tests/unit' --runInBand --forceExit",
    "test:integration": "jest --testPathPattern='tests/integration' --runInBand --forceExit",
    "test:e2e": "jest --testPathPattern='tests/e2e' --runInBand --forceExit",
    "test:load": "k6 run tests/load/booking.load.ts",
    "test:coverage": "jest --testPathPattern='tests/unit' --coverage --runInBand",
    "migrate:up": "DATABASE_URL=$DATABASE_URL ../../database/scripts/run_migrations.sh",
    "migrate:status": "psql $DATABASE_URL -c \"SELECT version, applied_at FROM schema_migrations ORDER BY applied_at;\"",
    "migrate:create": "echo \"Create a new file: database/migrations/$(date +%Y%m%d_%H%M%S)_description.sql\"",
    "seed": "ts-node -r tsconfig-paths/register src/infrastructure/database/seeds/index.ts",
    "seed:reset": "ts-node -r tsconfig-paths/register src/infrastructure/database/seeds/reset.ts",
    "keys:generate": "ts-node -r tsconfig-paths/register src/shared/utils/generate-keys.ts",
    "test:watch": "jest --testPathPattern='tests/unit' --watch"
  },
  "dependencies": {
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "pg": "^8.11.5",
    "pg-pool": "^3.6.2",
    "ioredis": "^5.3.2",
    "bullmq": "^5.8.1",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@aws-sdk/lib-storage": "^3.600.0",
    "razorpay": "^2.9.2",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "zod": "^3.23.8",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0",
    "express-rate-limit": "^7.3.1",
    "rate-limit-redis": "^4.2.0",
    "twilio": "^5.1.1",
    "nodemailer": "^6.9.14",
    "firebase-admin": "^12.2.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.4",
    "uuid": "^10.0.0",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "node-cron": "^3.0.3",
    "dotenv": "^16.4.5",
    "module-alias": "^2.2.3",
    "tsconfig-paths": "^4.2.0",
    "prom-client": "^15.1.3",
    "socket.io": "^4.7.5",
    "crypto": "^1.0.1",
    "ms": "^2.1.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/uuid": "^10.0.0",
    "@types/ms": "^0.7.34",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/nodemailer": "^6.4.15",
    "@types/node": "^20.14.2",
    "@types/node-cron": "^3.0.11",
    "@types/jest": "^29.5.12",
    "@types/supertest": "^6.0.2",
    "typescript": "^5.4.5",
    "ts-node-dev": "^2.0.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "supertest": "^7.0.0",
    "eslint": "^9.4.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "prettier": "^3.3.2",
    "eslint-config-prettier": "^9.1.0"
  },
  "_moduleAliases": {
    "@config": "dist/config",
    "@domains": "dist/domains",
    "@shared": "dist/shared",
    "@infrastructure": "dist/infrastructure"
  }
}
