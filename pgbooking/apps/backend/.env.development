# ─────────────────────────────────────────────
# PG Booking — Development Environment
# Used by: docker-compose.yml backend service
# ─────────────────────────────────────────────
# ⚠️  DO NOT commit real secrets. This file uses dev-only placeholder values.

NODE_ENV=development
PORT=3000
API_VERSION=v1
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,exp://localhost:8081

# ─── Database ────────────────────────────────
DATABASE_URL=postgresql://pgbooking_user:pgbooking_secret_dev@postgres:5432/pgbooking_dev
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# ─── Redis ───────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
REDIS_DB_CACHE=0
REDIS_DB_SESSION=1
REDIS_DB_LOCK=2
REDIS_DB_QUEUE=3

# ─── JWT (generate with: npm run keys:generate) ──
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# ─── Encryption ──────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ─── AWS S3 (LocalStack in dev) ──────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566
AWS_S3_BUCKET_KYC=pgbooking-kyc-dev
AWS_S3_BUCKET_PROPERTIES=pgbooking-properties-dev
AWS_S3_BUCKET_MAINTENANCE=pgbooking-maintenance-dev
AWS_S3_SIGNED_URL_EXPIRY_SECONDS=3600

# ─── Razorpay (test mode) ────────────────────
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_TEST_SECRET_KEY
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# ─── Twilio (OTP is logged in dev — Twilio not called when NODE_ENV=development) ──
TWILIO_ACCOUNT_SID=ACtest_placeholder
TWILIO_AUTH_TOKEN=test_placeholder
TWILIO_PHONE_NUMBER=+15005550006

# ─── Firebase FCM (skipped in dev) ───────────
FIREBASE_PROJECT_ID=pgbooking-dev
FIREBASE_PRIVATE_KEY_ID=dev_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nDEV_PLACEHOLDER_NOT_REAL\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@pgbooking-dev.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=000000000000000000000

# ─── Email (logged to console in dev) ────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=dev@pgbooking.local

# ─── Rate Limiting ────────────────────────────
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=1000
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=20

# ─── File Uploads ─────────────────────────────
UPLOAD_MAX_FILE_SIZE_MB=5
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

# ─── BullMQ ──────────────────────────────────
BULLMQ_CONCURRENCY=5

# ─── Booking ─────────────────────────────────
BOOKING_LOCK_TTL_MS=600000
BOOKING_LOCK_RETRY_COUNT=3
BOOKING_LOCK_RETRY_DELAY_MS=200
