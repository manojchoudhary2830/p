# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME="PG Booking API"
APP_VERSION=1.0.0
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ─────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://pgbooking_user:pgbooking_secret_dev@localhost:5432/pgbooking_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pgbooking_dev
DB_USER=pgbooking_user
DB_PASSWORD=pgbooking_secret_dev
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# DB allocation: 0=cache, 1=sessions, 2=locks, 3=bullmq
REDIS_CACHE_DB=0
REDIS_SESSION_DB=1
REDIS_LOCK_DB=2
REDIS_QUEUE_DB=3
REDIS_KEY_PREFIX=pgbooking:

# ─────────────────────────────────────────────
# JWT (RS256 — generate with: npm run keys:generate)
# ─────────────────────────────────────────────
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d
JWT_ISSUER=pgbooking-api
JWT_AUDIENCE=pgbooking-client

# ─────────────────────────────────────────────
# OTP Configuration
# ─────────────────────────────────────────────
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_LOCKOUT_DURATION_SECONDS=900

# ─────────────────────────────────────────────
# AWS S3
# ─────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET_KYC=pgbooking-kyc-prod
AWS_S3_BUCKET_PROPERTIES=pgbooking-properties-prod
AWS_S3_BUCKET_MAINTENANCE=pgbooking-maintenance-prod
AWS_S3_SIGNED_URL_EXPIRY_SECONDS=3600
# For local dev with LocalStack:
AWS_ENDPOINT_URL=http://localhost:4566

# ─────────────────────────────────────────────
# Razorpay
# ─────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ─────────────────────────────────────────────
# Twilio (SMS/OTP)
# ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_MESSAGING_SERVICE_SID=your_messaging_service_sid

# ─────────────────────────────────────────────
# Firebase (Push Notifications)
# ─────────────────────────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY_ID=your_firebase_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your_project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_firebase_client_id

# ─────────────────────────────────────────────
# Email (SMTP via Nodemailer)
# ─────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key
EMAIL_FROM=noreply@pgbooking.in
EMAIL_FROM_NAME="PG Booking"

# ─────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=500
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_OTP_WINDOW_MS=60000
RATE_LIMIT_OTP_MAX=3

# ─────────────────────────────────────────────
# Booking Engine
# ─────────────────────────────────────────────
BOOKING_LOCK_TTL_MS=600000
BOOKING_LOCK_RETRY_COUNT=3
BOOKING_LOCK_RETRY_DELAY_MS=100

# ─────────────────────────────────────────────
# File Upload
# ─────────────────────────────────────────────
UPLOAD_MAX_FILE_SIZE_MB=5
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

# ─────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=./logs
LOG_MAX_FILES=14d
LOG_MAX_SIZE=20m

# ─────────────────────────────────────────────
# Cron Jobs
# ─────────────────────────────────────────────
RENT_INVOICE_CRON=0 9 1 * *
RESERVATION_CLEANUP_CRON=*/10 * * * *
NOTIFICATION_REMINDER_CRON=0 10 * * *

# ─────────────────────────────────────────────
# Encryption (for sensitive data at rest)
# ─────────────────────────────────────────────
ENCRYPTION_KEY=32_char_hex_key_for_aes_256_gcm_
ENCRYPTION_IV_LENGTH=12

# ─────────────────────────────────────────────
# Socket.IO
# ─────────────────────────────────────────────
SOCKET_CORS_ORIGINS=http://localhost:3000,http://localhost:8081
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000
